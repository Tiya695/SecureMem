# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Groq (prompt injection classifier + default LLM) ---
GROQ_API_KEY=your_groq_api_key_here
# llama-3.1-8b-instant has been decommissioned by Groq — use a currently-available model.
# Verify with: client.models.list() via the groq SDK. openai/gpt-oss-20b is fast and returns
# clean JSON for the classifier prompt in firewall/detector.py / backend/main.py.
GROQ_MODEL=openai/gpt-oss-20b

# --- Auth / crypto ---
JWT_SECRET_KEY=your_jwt_secret_here
ENCRYPTION_KEY=your_fernet_key_here

# Required to mint an ADMIN-role JWT via POST /auth/token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, ADMIN token issuance is disabled entirely (fails closed).
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret_here

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/securemem

# --- CORS ---
# Origin of your deployed frontend, if different from the defaults already allowed
# (localhost:8000, 127.0.0.1:8000, localhost:3000, 127.0.0.1:3000, securemem-api.onrender.com).
FRONTEND_URL=

# --- Gateway: model-agnostic LLM provider (Phase 10A) ---
# groq (default, works out of the box) | openai | anthropic | gemini | ollama
SECUREMEM_LLM_PROVIDER=groq

# Only needed if SECUREMEM_LLM_PROVIDER is set to that provider — otherwise the connector
# reports {error: "provider_not_configured"} instead of crashing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
